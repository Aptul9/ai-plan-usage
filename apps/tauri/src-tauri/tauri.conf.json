{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-plan-usage",
  "version": "0.0.2",
  "identifier": "io.local.ai-plan-usage",
  "build": {
    "frontendDist": "../ui-dist",
    "devUrl": null,
    "beforeBuildCommand": "npm --prefix ../ui run build && node sync-ui.cjs",
    "beforeDevCommand": "npm --prefix ../ui run build && node sync-ui.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
